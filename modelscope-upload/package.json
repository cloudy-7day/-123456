{
  "name": "huawei-store-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "doctor": "node cli.mjs doctor",
    "demo": "node cli.mjs run --input examples/task.json --output output/latest.json",
    "test": "node --test tests/*.test.mjs modules/scenario/tests/*.test.mjs",
    "build": "vite build modules/scenario --base=/scenario/ --outDir ../../public/scenario",
    "package:modelscope": "node scripts/package-modelscope.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
