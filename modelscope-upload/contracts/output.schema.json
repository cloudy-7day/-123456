{
  "type": "object",
  "required": ["customer_insight", "strategy", "content", "image_plan", "sales_plan", "follow_up", "source_refs", "pending_confirmation"],
  "properties": {
    "customer_insight": { "type": "string", "title": "客户洞察", "description": "客户任务、顾虑、判断依据；区分已知和推测" },
    "strategy": { "type": "string", "title": "内容策略", "description": "场景切入、核心卖点和平台写法" },
    "content": { "type": "object", "title": "图文文案", "required": ["title", "body", "call_to_action"], "properties": {
      "title": { "type": "string", "title": "标题" },
      "body": { "type": "string", "title": "正文", "description": "约300字，事实后标注[S1]等引用，不输出思维过程" },
      "call_to_action": { "type": "string", "title": "行动引导" }
    } },
    "image_plan": { "type": "array", "title": "配图方案", "items": { "type": "object", "required": ["source_ref", "position", "caption"], "properties": {
      "source_ref": { "type": "string", "description": "只能选择提供的图片来源编号，例如I1" },
      "position": { "type": "string" },
      "caption": { "type": "string" }
    } } },
    "sales_plan": { "type": "object", "title": "销售方案", "required": ["quote", "demo_script"], "properties": {
      "quote": { "type": "string", "description": "本版本不计算报价，明确待提供价格与叠加规则" },
      "demo_script": { "type": "string", "description": "约3分钟的演示步骤、话术、检查点；未确认功能不编造操作" }
    } },
    "follow_up": { "type": "array", "title": "跟进计划", "items": { "type": "object", "required": ["day", "message"], "properties": {
      "day": { "type": "integer", "enum": [1, 3, 7] },
      "message": { "type": "string" }
    } } },
    "source_refs": { "type": "array", "title": "引用来源", "minItems": 1, "items": { "type": "string" } },
    "pending_confirmation": { "type": "array", "title": "待确认事项", "items": { "type": "string" } }
  }
}
