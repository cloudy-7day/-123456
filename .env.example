# Default knowledge source: bundled user-provided materials; ima keys optional.
KNOWLEDGE_SOURCE=local
# Copy to .env.local and configure on your own machine; never commit real credentials.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
HOST=127.0.0.1
PORT=8792

# The frozen local evaluation currently favors lexical. vector/hybrid are experimental.
# Real vector/hybrid search requires: pnpm search:build. Missing index is explicitly lexical_fallback.
SEARCH_MODE=lexical
# SEARCH_CACHE_DIR=/absolute/path/to/persistent/search-cache
